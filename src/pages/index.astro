  <div id="cookie-banner" class="fixed inset-x-4 bottom-4 z-[60] mx-auto hidden max-w-xl rounded-3xl border border-black/10 bg-white p-5 shadow-2xl"><p class="font-bold">Cookie 設定</p><p class="mt-2 text-sm leading-6 text-black/60">本站只在你同意後載入 Google Analytics 4（G-HXM22WWPKP）。必要功能不使用追蹤 Cookie。</p><div class="mt-4 flex gap-3"><button id="accept-analytics" class="rounded-full bg-[#111719] px-4 py-2 text-sm font-bold text-white">同意分析</button><button id="reject-analytics" class="rounded-full border border-black/20 px-4 py-2 text-sm font-bold">只用必要功能</button></div></div>

  <script is:inline>
    (() => {
      const KEY = 'cmle-cookie-choice';
      const banner = document.getElementById('cookie-banner');
      const loadGA = () => {
        if (document.querySelector('script[data-ga4]')) return;
        const s = document.createElement('script'); s.async = true; s.dataset.ga4 = 'true'; s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP'; document.head.appendChild(s);
        window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments)}; window.gtag = gtag; gtag('js', new Date()); gtag('config', 'G-HXM22WWPKP', { anonymize_ip: true });
      };
      const saved = localStorage.getItem(KEY); if (!saved) banner?.classList.remove('hidden'); if (saved === 'yes') loadGA();
      document.getElementById('accept-analytics')?.addEventListener('click', () => { localStorage.setItem(KEY,'yes'); loadGA(); banner?.classList.add('hidden'); });
      document.getElementById('reject-analytics')?.addEventListener('click', () => { localStorage.setItem(KEY,'no'); banner?.classList.add('hidden'); });
      document.getElementById('cookie-settings')?.addEventListener('click', () => banner?.classList.remove('hidden'));
    })();
