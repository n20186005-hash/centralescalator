---
import '../styles/global.css';
import { ATTRACTION, SITE_URL } from '../data/site';
import { localizedPath } from '../i18n';

export const prerender = true;
---

<!doctype html>
<html lang="zh-HK">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>找不到頁面 | 中環半山扶手電梯香港旅遊指南</title>
    <meta name="robots" content="noindex, follow" />
    <meta
      name="description"
      content="頁面不存在。返回中環半山扶手電梯（中環至半山自動扶梯系統）的運作時間、交通指南、周邊景點與美食攻略。"
    />
    <link rel="canonical" href={`${SITE_URL}/404`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111719" />
  </head>
  <body class="grain">
    <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center px-5 py-20">
      <p class="font-mono text-xs font-bold tracking-[.25em] text-[#ef3f2f]">404</p>
      <h1 class="mt-3 text-4xl font-black md:text-5xl">找不到這個頁面。</h1>
      <p class="mt-6 leading-8 text-black/70">
        你訪問的地址可能已經更改或不存在。你可以返回中環半山扶手電梯的完整指南，或前往運作時間、交通指南、周邊美食與周邊景點專頁。
      </p>
      <ul class="mt-8 space-y-3">
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('zh', '')}>中環半山扶手電梯完整指南（繁體中文）</a></li>
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('zh', 'schedule/')}>運作時間與乘搭攻略</a></li>
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('zh', 'directions/')}>交通指南與地圖</a></li>
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('zh', 'food/')}>沿途美食推薦</a></li>
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('zh', 'attractions/')}>周邊景點推薦</a></li>
        <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={localizedPath('en', '')}>Central-Mid-Levels Escalators guide (English)</a></li>
      </ul>
      <p class="mt-10 text-sm text-black/50">
        Google Maps：{ATTRACTION.mapsUrl}
      </p>
    </main>
  </body>
</html>
