---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePage from '../../components/GuidePage.astro';
import { CHECK_DATE, publishedGuides, getGuide } from '../../content/guides';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { localizedPath } from '../../i18n';
import { SITE_URL, withSiteName } from '../../data/site';

export const prerender = true;

export interface Props {
  slug: string;
}

export function getStaticPaths() {
  return publishedGuides().map((guide) => ({
    params: { guide: guide.slug },
    props: { slug: guide.slug },
  }));
}

const { slug } = Astro.props;
const locale = 'en' as const;
const guide = getGuide(slug)!;
const c = guide.content[locale];
const path = `${slug}/`;
const url = `${SITE_URL}${localizedPath(locale, path)}`;
const jsonLd = [
  articleSchema({ locale, title: c.meta.title, description: c.meta.description, url, dateModified: CHECK_DATE }),
  faqSchema(c.faqs),
  breadcrumbSchema([
    { name: 'Home', path: `${SITE_URL}/en/` },
    { name: 'Topic guides', path: `${SITE_URL}/en/#guides` },
    { name: guide.title[locale], path: url },
  ]),
];
---

<BaseLayout
  locale={locale}
  path={path}
  title={withSiteName(c.meta.title, locale)}
  description={c.meta.description}
  jsonLd={jsonLd}
>
  <GuidePage locale={locale} slug={slug} />
</BaseLayout>
