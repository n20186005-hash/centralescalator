import type {Locale} from '../i18n';import{pick}from'../i18n';const{locale}=Astro.props as{locale:Locale};
const links=[['https://www.td.gov.hk/en/transport_in_hong_kong/pedestrians/hillside_escalator/','運輸署：系統、方向及管理單位','Transport Department: system, direction and manager'],['https://www.discoverhongkong.com/eng/place-to-go/travel.guide-central-mid-levels-escalator.html','旅發局：路線與不同上行起始列示','Tourism Board: route and differing uphill start'],['https://www.emsd.gov.hk/railway_city/en/safety2.html','機電工程署：扶梯安全與推車／輪椅','EMSD: escalator safety, pushchairs and wheelchairs'],['https://www.gohk.gov.hk/en/spots/spot_detail.php?spot=Central+to+Mid-Levels+Escalator+and+Walkway+System','民政事務總署：地點與行程規劃','Home Affairs Department: route-planning reference'],['https://partnernet.hktb.com/filemanager/japan/localupdate/5317/file/Transporation_final.pdf','旅發局交通手冊：公共扶梯乘搭費用參考（舊版手冊）','Tourism Board transport handbook: fare reference (older handbook)'],['https://www.centralmarket.hk/en/','中環街市經營方','Central Market operator'],['https://www.taikwun.hk/en/visit/visiting-information','大館官方訪客資料','Tai Kwun visitor information'],['https://www.taikwun.hk/en/shop-and-dine','大館官方餐飲目錄','Tai Kwun dining directory'],['https://www.gohk.gov.hk/en/spots/spot_detail.php?spot=PMQ','政府PMQ介紹','Government introduction to PMQ'],['https://www.hkemobility.gov.hk/','運輸署HKeMobility交通規劃','Transport Department HKeMobility planner'],['https://www.hko.gov.hk/','香港天文台警告與預報','Hong Kong Observatory forecasts and warnings']];
---
<section class="source-list" id="sources"><h2>{pick(locale,'資料來源與查閱範圍','Sources and scope')}</h2><p>{pick(locale,'2026-10-30查閱。各來源涵蓋不同實體與服務；未核實的即時營運、通用步程、店家菜單或無障礙路線不作保證。本站沒有即時天氣或全線運作監控。','Reviewed 2026-10-30. Sources cover different places and services. Live operation, universal walking times, menus and complete accessible routes were not verified. This site has no live weather or whole-system monitoring.')}</p><ul>{links.map(([href,zh,en])=><li><a href={href} target="_blank" rel="noopener noreferrer">{locale==='en'?en:zh} ↗</a></li>)}</ul></section>
