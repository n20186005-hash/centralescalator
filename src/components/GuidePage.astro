---
import Sources from './Sources.astro';
import { CHECK_DATE, getGuide, groupById, guideHref, mapsSearchUrl, isPublished } from '../content/guides';
import type { GuideDef } from '../content/guides/types';
import { localizedPath, ui } from '../i18n';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const guide = getGuide(slug);
if (!guide) throw new Error(`Unknown guide slug: ${slug}`);

const c = guide.content[locale];
const t = ui[locale];
const homeHref = localizedPath(locale, '');
const guidesHref = `${homeHref}#guides`;
const group = groupById(guide.group);
const related = guide.related
  .map((relatedSlug) => getGuide(relatedSlug))
  .filter((item): item is GuideDef => Boolean(item) && isPublished(item));
---

<article class="mx-auto max-w-4xl px-5 py-16">
  <nav aria-label={locale === 'en' ? 'Breadcrumb' : '麵包屑導覽'} class="text-sm text-black/50">
    <a href={homeHref} class="hover:text-[#ef3f2f]">{t.home}</a>
    <span class="px-2">/</span>
    <a href={guidesHref} class="hover:text-[#ef3f2f]">{t.guideAll}</a>
    <span class="px-2">/</span>
    <span>{guide.title[locale]}</span>
  </nav>

  <p class="mt-8 font-mono text-xs font-bold tracking-[.25em] text-[#ef3f2f]">
    {c.kicker} · {t.guideGroup}：{group.label[locale]}
  </p>
  <h1 class="mt-4 text-4xl font-black leading-tight md:text-5xl">{c.h1}</h1>
  <p class="mt-6 text-lg leading-8 text-black/70">{c.lead}</p>
  <p class="mt-4 text-xs leading-6 text-black/45">{t.updated}：{CHECK_DATE} · {t.guideCheck}</p>

  {
    c.mapsQuery && (
      <p class="mt-6">
        <a
          class="inline-flex rounded-full border border-black/20 bg-white px-5 py-2 text-sm font-bold hover:border-[#ef3f2f] hover:text-[#ef3f2f]"
          href={mapsSearchUrl(c.mapsQuery)}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.guideMapSearch}
        </a>
      </p>
    )
  }

  <section class="mt-12 rounded-3xl border border-black/10 bg-white p-6" aria-label={t.guideQuickFacts}>
    <h2 class="text-xl font-black">{t.guideQuickFacts}</h2>
    <dl class="mt-5 grid gap-4 sm:grid-cols-2">
      {
        c.facts.map((fact) => (
          <div class="border-l-4 border-[#ef3f2f] pl-4">
            <dt class="text-xs font-bold uppercase tracking-widest text-black/45">{fact.label}</dt>
            <dd class="mt-1 leading-7 text-black/75">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {
    c.sections.map((section) => (
      <section class="mt-14">
        <h2 class="text-3xl font-black">{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => <p class="mt-4 leading-8 text-black/70">{paragraph}</p>)}
        {section.bullets && (
          <ul class="mt-6 space-y-5">
            {section.bullets.map((bullet) => (
              <li class="border-l-4 border-[#ef3f2f] pl-5">
                <p class="text-lg font-bold">{bullet.title}</p>
                <p class="mt-1 leading-7 text-black/65">{bullet.text}</p>
              </li>
            ))}
          </ul>
        )}
        {section.table && (
          <div class="mt-6 overflow-x-auto rounded-2xl border border-black/10 bg-white">
            <table class="w-full border-collapse text-left text-sm">
              <caption class="block px-4 pt-4 text-left text-xs text-black/50">{section.table.caption}</caption>
              <thead class="bg-[#f4f0e6]">
                <tr>
                  {section.table.columns.map((column) => (
                    <th scope="col" class="px-4 py-3 font-bold">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {section.table.rows.map((row) => (
                  <tr class="border-t border-black/10 align-top">
                    {row.map((cell) => (
                      <td class="px-4 py-3 leading-6 text-black/70">{cell}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {section.steps && (
          <div class="mt-6">
            <p class="text-xs font-bold uppercase tracking-widest text-black/45">{t.guideSteps}</p>
            <ol class="mt-4 space-y-4">
              {section.steps.map((step, index) => (
                <li class="flex gap-4 rounded-2xl bg-[#f4f0e6] p-5">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#111719] text-sm font-black text-white">
                    {index + 1}
                  </span>
                  <div>
                    <p class="text-lg font-bold">{step.label}</p>
                    <p class="mt-1 leading-7 text-black/65">{step.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}
      </section>
    ))
  }

  <section id="faq" class="mt-16">
    <p class="font-mono text-xs font-bold tracking-[.25em] text-[#ef3f2f]">{t.faqKicker}</p>
    <h2 class="mt-3 text-3xl font-black">{t.faqTitle}</h2>
    <div class="mt-6 divide-y divide-black/10 border-y border-black/10">
      {
        c.faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold">
              <span>{item.q}</span>
              <span class="text-[#ef3f2f] transition group-open:rotate-45">＋</span>
            </summary>
            <p class="max-w-3xl pt-4 leading-7 text-black/65">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mt-16 rounded-3xl bg-[#f4f0e6] p-7">
    <h2 class="text-2xl font-black">{t.guideRelated}</h2>
    <p class="mt-2 text-sm leading-6 text-black/60">{t.guideRelatedLead}</p>
    <ul class="mt-5 grid gap-2 sm:grid-cols-2">
      {
        related.map((item) => (
          <li>
            <a
              class="font-bold text-[#ef3f2f] underline decoration-2"
              href={guideHref(locale, item.slug)}
            >
              {item.title[locale]} →
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="mt-6 space-y-2 border-t border-black/10 pt-5">
      <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={guidesHref}>{t.guideAll}</a></li>
      <li><a class="font-bold text-[#ef3f2f] underline decoration-2" href={homeHref}>{t.backToGuide}</a></li>
    </ul>
  </section>

  <Sources locale={locale} />
</article>
