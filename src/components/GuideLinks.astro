---
import { GUIDES, guidesByGroup, guideHref, publishedGroups, publishedGuides, isPublished } from '../content/guides';
import { ui } from '../i18n';
import type { Locale } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
---

<section id="guides" class="mx-auto max-w-6xl px-5 py-20">
  <p class="font-mono text-xs font-bold tracking-[.25em] text-[#ef3f2f]">{t.guidesKicker}</p>
  <h2 class="mt-3 text-4xl font-black md:text-5xl">{t.guidesTitle}</h2>
  <p class="mt-5 max-w-3xl leading-8 text-black/65">{t.guidesLead}</p>
  <p class="mt-3 text-sm text-black/50">{t.guidesCount}</p>

  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {
      publishedGroups().map((group) => (
        <article class="rounded-3xl border border-black/10 bg-white p-6">
          <h3 class="text-2xl font-black">{group.label[locale]}</h3>
          <p class="mt-2 text-sm leading-6 text-black/60">{group.lead[locale]}</p>
          <ul class="mt-5 grid gap-2 sm:grid-cols-2">
            {guidesByGroup(group.id).filter(isPublished).map((guide) => (
              <li>
                <a
                  class="group inline-flex items-start gap-2 text-sm font-bold leading-6 text-[#111719] hover:text-[#ef3f2f]"
                  href={guideHref(locale, guide.slug)}
                >
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[#ef3f2f]"></span>
                  <span class="underline decoration-black/20 decoration-1 underline-offset-4 group-hover:decoration-[#ef3f2f]">
                    {guide.title[locale]}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="mt-3 text-sm text-black/50">{t.guidesCount}</p>
  <p class="mt-8 text-xs leading-6 text-black/45">
    {publishedGuides().length} / {GUIDES.length} · {t.guideCheck}
  </p>
</section>
